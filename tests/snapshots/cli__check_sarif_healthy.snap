---
source: tests/cli.rs
expression: out
---
{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "checkpoint-studio",
          "version": "[VERSION]",
          "informationUri": "https://github.com/antont-cerebras/checkpoint-studio",
          "rules": [
            {
              "id": "byte_ranges",
              "name": "Byte-range integrity",
              "shortDescription": {
                "text": "safetensors spans contiguous, sized correctly, no truncation"
              }
            },
            {
              "id": "layers",
              "name": "Layer completeness",
              "shortDescription": {
                "text": "layer indices contiguous, tensor set uniform across layers"
              }
            },
            {
              "id": "shapes_dtypes",
              "name": "Shape / dtype sanity",
              "shortDescription": {
                "text": "no duplicate names, no empty tensors, dtypes defined and uniform within each role"
              }
            },
            {
              "id": "headers",
              "name": "Header consistency",
              "shortDescription": {
                "text": "every header read, data 8-byte aligned, no tensor in two shards, index total right"
              }
            },
            {
              "id": "config",
              "name": "Config consistency",
              "shortDescription": {
                "text": "tensor tree matches config.json"
              }
            },
            {
              "id": "files",
              "name": "Files & sharding",
              "shortDescription": {
                "text": "index matches files on disk, shard numbering complete"
              }
            },
            {
              "id": "s3_metadata",
              "name": "S3 object metadata",
              "shortDescription": {
                "text": "every tensor's dtype/shape matches its own object's metadata, and each object holds the bytes it declares"
              }
            }
          ]
        }
      },
      "results": []
    }
  ]
}
